@model CallMSGraph.Models.VisorCalendarioModel;

<style>
    .visor-wide { width: 96vw; position: relative; left: 50%; transform: translateX(-50%); }
    .visor-search .form-group { margin-right: 1rem; margin-bottom: .5rem; }
    .visor-search input, .visor-search select { min-width: 11rem; }
    .visor-table { font-size: .85rem; }
    .visor-table thead th {
        background: #343a40; color: #fff; border: 0; white-space: nowrap;
        position: sticky; top: 0; z-index: 1;
    }
    .visor-table td { vertical-align: middle; }
    .visor-table tbody tr:hover { background-color: #f1f5fb; }
    .visor-table tbody tr.row-logged { background-color: #e9f7ef; }
    .visor-table tbody tr.row-logged:hover { background-color: #dcf1e5; }
    .visor-table .col-action { width: 6.5rem; text-align: center; }
    .visor-table .col-action button { min-width: 5.5rem; }
    .visor-table .col-subject { min-width: 16rem; }
    .visor-table .col-date { white-space: nowrap; }
    .visor-table input[readonly] {
        border: 0; background: transparent; padding: 0; width: 100%; min-width: 4rem; color: #495057;
    }
    .visor-table input[name='jiraStartDate'], .visor-table input[name='jiraCreateDate'] { min-width: 11rem; }
    .visor-summary { color: #6c757d; }
</style>

<div class="visor-wide">
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white"><h5 class="mb-0">Search calendar events</h5></div>
        <div class="card-body">
            <form method="get" class="form-inline visor-search">
                <div class="form-group">
                    <label class="mr-2 font-weight-bold" for="From">From</label>
                    @Html.EditorFor(x => x.From, new { htmlAttributes = new { @class = "form-control" } })
                </div>
                <div class="form-group">
                    <label class="mr-2 font-weight-bold" for="To">To</label>
                    @Html.EditorFor(x => x.To, new { htmlAttributes = new { @class = "form-control" } })
                </div>
                <div class="form-group">
                    <label class="mr-2 font-weight-bold" for="Prefix">Project</label>
                    @Html.DropDownListFor(m => m.Prefix, new SelectList(Model.Projects, "Value", "Text"), "Select", new { @class = "form-control" })
                </div>
                <button class="btn btn-primary mb-2">SEARCH</button>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center">
            <h5 class="mb-0">Results</h5>
            @if (Model?.Calendar != null)
            {
                <div class="d-flex align-items-center">
                    <span class="visor-summary mr-3" id="summary"></span>
                    <button type="button" id="addAll" class="btn btn-success">ADD ALL</button>
                </div>
            }
        </div>
        @if (Model?.Calendar != null)
        {
            <div class="table-responsive">
            <table class="table table-sm table-borderless mb-0 visor-table">
                <thead>
                    <tr>
                        <th class="col-action">Actions</th>
                        <th>Issue</th>
                        <th>Subject</th>
                        <th>StartDate</th>
                        <th>EndDate</th>
                        <th>Jira ID</th>
                        <th>Jira Hs</th>
                        <th>Jira StartDate</th>
                        <th>Jira CreateDate</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Calendar)
                    {
                        <form method="post" action="@Url.Action("Update")">
                        <tr class="@(item.JiraWorkLog != null ? "row-logged" : "")">
                            <td class="col-action">
                                @if (item.JiraWorkLog != null)
                                {
                                    <button name="action" class="btn btn-sm btn-outline-danger">REMOVE</button>
                                }
                                else
                                {
                                    <button name="action" class="btn btn-sm btn-success">ADD</button>
                                }
                            </td>
                            <td><strong>@item.Issue</strong> <input type="hidden" name="issue" value="@item.Issue"></td>
                            <td class="col-subject">@item.Subject <input type="hidden" name="subject" value="@item.Subject"></td>
                            <td class="col-date">@item.StartDate <input type="hidden" name="startDate" value="@item.StartDate.ToUniversalTime().Ticks"></td>
                            <td class="col-date">@item.EndDate <input type="hidden" name="endDate" value="@item.EndDate.ToUniversalTime().Ticks"></td>
                            <td><input type="text" readonly="readonly" name="Id" value="@item.JiraWorkLog?.Id"></td>
                            <td><input type="text" readonly="readonly" name="jiraLength" value="@item.JiraWorkLog?.Length"></td>
                            <td><input type="datetime" readonly="readonly" name="jiraStartDate" value="@item.JiraWorkLog?.StartDate"></td>
                            <td><input type="datetime" readonly="readonly" name="jiraCreateDate" value="@item.JiraWorkLog?.CreateDate"></td>
                        </tr>
                        </form>
                    }
                </tbody>
            </table>
            </div>
        }
        else
        {
            <div class="card-body text-muted">Pick a date range and project, then press SEARCH.</div>
        }
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    let $ = jQuery;
    $(document).ready(function () {

        const $formulario = $("form[method='post']");

        // Reflects the Jira worklog state in the row button, row color and summary
        function setRowState(form, logged) {
            const button = form.elements['action'];
            button.innerText = logged ? "REMOVE" : "ADD";
            $(button).toggleClass("btn-outline-danger", logged).toggleClass("btn-success", !logged);
            $(button).closest("tr").toggleClass("row-logged", logged);
            refreshSummary();
        }

        function refreshSummary() {
            const total = $formulario.length;
            const pending = $formulario.filter(function () { return !this.elements['Id'].value; }).length;
            $("#summary").text(`${total} events · ${total - pending} in Jira · ${pending} pending`);
            $("#addAll").prop("disabled", pending === 0);
        }
        refreshSummary();

        if (!$formulario) {
            console.error("No se pudo encontrar el formulario");
        }

        /* attach a submit handler to the forms */
        $formulario.submit(function (event) {

            /* stop form from submitting normally */
            event.preventDefault();

            /* get the action attribute from the <form action=""> element */
            let form = this;
            let $form = $(form);

            // Spinner
            let cont = 0;
            let interval = setInterval(() => { 
                
                if (cont > 3) cont = 0;
                cont++;
                let text = "";
                for (let i = 1; i <= cont; i++) {
                    text = text + ".";
                }

                form.elements['action'].innerText = text;
            }, 500);
            form.elements['action'].disabled = true;         

            var formData = new FormData(event.target);
            let values = Object.fromEntries(formData);

            let url = '@Url.Action("Create")';
            let done = (data) => {
                setRowState(form, true);
                form.elements['Id'].value = data.id;
                form.elements['jiraCreateDate'].value = data.createDate;
                form.elements['jiraLength'].value = data.length;
                form.elements['jiraStartDate'].value = data.startDate;
            };

            if (values.Id) {
                url = '@Url.Action("Delete")';
                done = (data) => {
                    setRowState(form, false);
                    form.elements['Id'].value = "";
                    form.elements['jiraCreateDate'].value = "";
                    form.elements['jiraLength'].value = "";
                    form.elements['jiraStartDate'].value = "";
                };
            }

            //let data = $form.serialize();

            /* Send the data using post with element id name and name2*/
            let posting = $.post(url, values);
            $form.data('posting', posting);

            /* Alerts the results */
            posting.done(done);

            posting.fail(function (err) {
                alert(err);
            });

            posting.always(() => { 
                clearInterval(interval);
                form.elements['action'].disabled = false;
            });
        });

        /* ADD ALL: submit sequentially every row that has no Jira worklog yet */
        $("#addAll").click(async function () {
            const $button = $(this);
            $button.prop("disabled", true);
            try {
                const pending = $formulario.filter(function () {
                    return !this.elements['Id'].value;
                }).toArray();

                for (const form of pending) {
                    const $form = $(form);
                    $form.removeData('posting');
                    $form.trigger('submit');
                    const posting = $form.data('posting');
                    if (posting) {
                        try {
                            await posting;
                        } catch (e) {
                            break; // the submit handler already reported the error
                        }
                    }
                }
            } finally {
                refreshSummary();
            }
        });

        (function () { 
            // Function to convert ticks to JavaScript Date object
            function ticksToDate(ticks) {
                var epochTicks = 621355968000000000; // Ticks at Unix epoch (January 1, 1970)
                var ticksPerMillisecond = 10000;     // There are 10,000 ticks per millisecond
                var msSinceEpoch = (ticks - epochTicks) / ticksPerMillisecond;
                return new Date(msSinceEpoch);
            }

            function formatDate(date) {
                // Array of short month names
                const shortMonths = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

                // Extract components
                const month = shortMonths[date.getMonth()]; // Get short month name
                const day = ('0' + date.getDate()).slice(-2);
                const hours = ('0' + date.getHours()).slice(-2);
                const minutes = ('0' + date.getMinutes()).slice(-2);

                // Return in Mon/dd hh:mm format
                return `${day}/${month} ${hours}:${minutes}`;
            }

            // Function to update the date text before input
            function updateDateText(inputName) {
                $('td:has(input[name="' + inputName + '"])').each(function () {
                    const input = $(this).find('input[name="' + inputName + '"]');
                    const ticks = parseInt(input.val());
                    const date = ticksToDate(ticks);
                    const formattedDate = formatDate(date);
                    $(this).contents().filter(function () {
                        return this.nodeType === 3; // Text node
                    }).first().replaceWith(formattedDate + ' ');
                });
            }

            // Update StartDate and EndDate texts
            updateDateText('startDate');
            updateDateText('endDate');
        })();
    });
</script>


